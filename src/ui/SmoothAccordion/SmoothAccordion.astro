---
const items = [
  {
    title: "Is there a free trial available?",
    content: "Yes, you can try our platform for free for 14 days. No credit card required.",
  },
  {
    title: "Can I upgrade my plan later?",
    content: "Of course. You can upgrade or downgrade your plan at any time from your account settings.",
  },
  {
    title: "Do you offer technical support?",
    content: "All plans include access to our community forum and standard email support.",
  },
];
---

<div class="w-full max-w-2xl space-y-3">
  {
    items.map((item, index) => {
      const id = `accordion-${Math.random().toString(36).substring(2, 9)}-${index}`;
      return (
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-1">
          <input type="checkbox" id={id} class="peer sr-only" />
          <label
            for={id}
            class="flex cursor-pointer items-center justify-between gap-4 rounded-lg px-4 py-3 text-left focus-within:ring-2 focus-within:ring-slate-400 focus-within:ring-offset-2 focus-within:ring-offset-slate-950"
            tabindex="0"
            data-accordion-label={id}
          >
            <span class="text-sm font-semibold text-slate-100">{item.title}</span>
            <svg
              class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 peer-checked:rotate-180"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 011.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </label>

          <div class="grid grid-rows-[0fr] transition-all duration-300 peer-checked:grid-rows-[1fr]">
            <div class="overflow-hidden">
              <div class="px-4 pb-4 text-sm leading-relaxed text-slate-400">
                {item.content}
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  function initAccordions() {
    document.querySelectorAll('[data-accordion-label]').forEach(label => {
      // Prevent multiple listeners
      const newLabel = label.cloneNode(true);
      label.parentNode.replaceChild(newLabel, label);
      
      newLabel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const targetId = newLabel.getAttribute('data-accordion-label');
          document.getElementById(targetId)?.click();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initAccordions);
  if (document.readyState === 'complete') {
    initAccordions();
  } else {
    document.addEventListener('DOMContentLoaded', initAccordions);
  }
</script>
